# Copy to backend/.env (gitignored). Every value has a working default except keys.

# --- LLM (OpenAI-compatible chat + tool-calling API) -----------------------------
LLM_PROVIDER=ollama                      # ollama | sarvam
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:2b-mlx                 # fallback: gemma4:e2b-mlx
LLM_REASONING_EFFORT=none                # "none" disables thinking: 3-5x faster, same tool-call quality
LLM_API_KEY=                             # Ollama needs none. Sarvam: your key.
LLM_TIMEOUT_SECONDS=120

# --- Our MCP tool server (the six tools) -----------------------------------------
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
# Where the agent reaches it with AgntID OFF. Leave default for local runs.
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
# What the AgntID Docker runtime uses to reach our server (set in the AgntID portal):
#   http://host.docker.internal:8765/mcp

# --- AgntID runtime (phase c) ----------------------------------------------------
AGNTID_MCP_URL=http://localhost:8082/mcp
AGNTID_ACCESS_TOKEN=                     # only if the runtime requires OAuth

# --- Behaviour -------------------------------------------------------------------
PAYMENT_LIMIT_INR=10000
AGENT_CONCURRENCY=1
CACHE_DIR=.cache
NONCE_SECRET=whosaid-demo-nonce-secret   # derives the per-message prompt fence; change for any real use
LOG_LEVEL=INFO
