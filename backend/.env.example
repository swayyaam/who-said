# Copy to backend/.env (gitignored). Every value has a working default except keys.

# --- LLM (OpenAI-compatible chat + tool-calling API) -----------------------------
LLM_PROVIDER=ollama                      # ollama | sarvam
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:2b-mlx                 # fallback: gemma4:e2b-mlx
LLM_REASONING_EFFORT=none                # "none" disables thinking: 3-5x faster, same tool-call quality
LLM_API_KEY=                             # Ollama needs none. Sarvam: your key.
LLM_TIMEOUT_SECONDS=120

# --- Our MCP tool server (the six tools) -----------------------------------------
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
# Where the agent reaches it with AgntID OFF. Leave default for local runs.
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
# What the AgntID Docker runtime uses to reach our server (set in the AgntID portal):
#   http://host.docker.internal:8765/mcp

# --- AgntID runtime (phase c) ----------------------------------------------------
AGNTID_MCP_URL=http://localhost:8082/mcp
AGNTID_ACCESS_TOKEN=                     # only if the runtime requires OAuth

# --- Profile learning (per-user engagement scores) -------------------------------
PROFILE_MIN_ALPHA=0.1                    # alpha = max(MIN_ALPHA, 1/(n+1))
PROFILE_MIN_EVIDENCE=2                   # interactions needed before a score may influence routing
PROFILE_DOWNGRADE_BELOW=-0.4             # notify -> digest
PROFILE_MUTE_BELOW=-0.7                  # digest -> mute (sender/business evidence only)
PROFILE_UPGRADE_ABOVE=0.6                # digest -> notify (sender/business evidence only)

# --- Behaviour -------------------------------------------------------------------
PAYMENT_LIMIT_INR=10000
AGENT_CONCURRENCY=1
CACHE_DIR=.cache
NONCE_SECRET=whosaid-demo-nonce-secret   # derives the per-message prompt fence; change for any real use
LOG_LEVEL=INFO

# --- Tool-server access control ------------------------------------------------------
# The tool server's /mcp endpoint requires a bearer secret. The AgntID runtime sends TOOL_SERVER_SECRET
# (configured in the portal as the credential ${WHOSAID_TOOL_SECRET}, an env var on the runtime container).
TOOL_SERVER_SECRET=
# Demo-only bypass for the AgntID-OFF comparison run. The server honours DIRECT_ACCESS_SECRET only when
# DEMO_ALLOW_DIRECT=true. In production leave both unset: the only way in is through AgntID.
DEMO_ALLOW_DIRECT=false
DIRECT_ACCESS_SECRET=

# --- HTTP API ----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # the Vite dev server
DEFAULT_LIVE=false                        # true: dashboard runs call the live model instead of replaying the demo fixture
